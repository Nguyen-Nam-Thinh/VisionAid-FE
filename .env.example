VITE_SERVICE_MODE=mock
# Public URL only. API contracts must be implemented before switching to api.
VITE_API_BASE_URL=
# Optional full HTTP(S) hub URL; blank uses VITE_API_BASE_URL + /hubs/location.
# Production example: https://api.visionaid.net/hubs/location
VITE_SIGNALR_URL=
VITE_MAPBOX_PUBLIC_TOKEN=
# Optional overrides for the public Firebase web configuration supplied for VisionAid.
# Empty values use src/configs/firebase.ts. Never put Firebase Admin credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_VAPID_KEY=
