# Staging build (Vercel Preview for the dev branch). Copy these into Vercel → Settings →
# Environment Variables with the "Preview" scope, branch "dev". Every VITE_* value is public.
VITE_SERVICE_MODE=api
# Staging API behind Cloudflare (DNS record staging-api, proxied), no trailing slash.
VITE_API_BASE_URL=https://staging-api.visionaid.net
# Blank uses VITE_API_BASE_URL + /hubs/location.
VITE_SIGNALR_URL=
# Public Mapbox token (pk.*); the production one also works if it has no URL restriction.
VITE_MAPBOX_PUBLIC_TOKEN=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_VAPID_KEY=
